+// Licensed to the .NET Foundation under one or more agreements.
+// The .NET Foundation licenses this file to you under the MIT license.
+
+using ILCompiler.DependencyAnalysis;
+
+using Xunit;
+
+namespace ILCompiler.Compiler.Tests
+{
+    public class IncrementalCodeStateValidatorTests
+    {
+        [Fact]
+        public void AcceptsEquivalentCodeState()
+        {
+            FrameInfo[] frames =
+            {
+                new FrameInfo(default, 0, 10, new byte[] { 1, 2 }),
+            };
+
+            Assert.True(IncrementalCodeStateValidator.Matches(
+                frames,
+                new byte[] { 3, 4 },
+                oldHasEhInfo: false,
+                frames,
+                new byte[] { 3, 4 },
+                newHasEhInfo: false,
+                out string reason), reason);
+        }
+
+        [Theory]
+        [InlineData("old-eh")]
+        [InlineData("new-eh")]
+        [InlineData("gc")]
+        [InlineData("frame-count")]
+        [InlineData("frame")]
+        public void RejectsChangedCodeState(string change)
+        {
+            FrameInfo[] oldFrames =
+            {
+                new FrameInfo(default, 0, 10, new byte[] { 1, 2 }),
+            };
+            FrameInfo[] newFrames =
+            {
+                new FrameInfo(
+                    change == "frame" ? FrameInfoFlags.Handler : default,
+                    0,
+                    10,
+                    new byte[] { 1, 2 }),
+            };
+            if (change == "frame-count")
+            {
+                newFrames = System.Array.Empty<FrameInfo>();
+            }
+
+            Assert.False(IncrementalCodeStateValidator.Matches(
+                oldFrames,
+                new byte[] { 3, 4 },
+                oldHasEhInfo: change == "old-eh",
+                newFrames,
+                change == "gc" ? new byte[] { 3, 5 } : new byte[] { 3, 4 },
+                newHasEhInfo: change == "new-eh",
+                out string reason));
+            Assert.False(string.IsNullOrEmpty(reason));
+        }
+    }
+}
diff --git a/src/coreclr/tools/aot/ILCompiler.Compiler.Tests/IncrementalObjectPatchTests.cs b/src/coreclr/tools/aot/ILCompiler.Compiler.Tests/IncrementalObjectPatchTests.cs
new file mode 100644
index 000000000..6ba66efc6
--- /dev/null
+++ b/src/coreclr/tools/aot/ILCompiler.Compiler.Tests/IncrementalObjectPatchTests.cs
@@ -0,0 +1,254 @@
+// Licensed to the .NET Foundation under one or more agreements.
+// The .NET Foundation licenses this file to you under the MIT license.
+
+using System;
+using System.IO;
+
+using ILCompiler.DependencyAnalysis;
+using ILCompiler.ObjectWriter;
+
+using Internal.Text;
+
+using Xunit;
+
+namespace ILCompiler.Compiler.Tests
+{
+    public class IncrementalObjectPatchTests
+    {
+        [Fact]
+        public void PatchesSingleByteAndPersistsOutput()
+        {
+            using var files = new TemporaryFiles();
+            var node = new TestObjectNode(new byte[] { 1, 2, 3 });
+            Record(node, fileOffset: 10);
+            files.WriteBaseBytes(10, node.GetData(factory: null).Data);
+            node.SetData(new byte[] { 1, 9, 3 });
+
+            Assert.True(IncrementalObjectPatch.TryPatch(
+                files.BasePath,
+                files.OutputPath,
+                new[] { node },
+                factory: null,
+                out string reason,
+                out long patchedByteCount), reason);
+            Assert.Equal(1, patchedByteCount);
+
+            byte[] result = File.ReadAllBytes(files.OutputPath);
+            byte[] expected = new byte[64];
+            expected[10] = 1;
+            expected[11] = 9;
+            expected[12] = 3;
+            Assert.Equal(expected, result);
+        }
+
+        [Theory]
+        [InlineData("base-byte", "base-object-byte-does-not-match-recorded-fragment")]
+        [InlineData("existing-output", "patched-object-output-already-exists")]
+        public void RejectsUnsafeDestinationState(string change, string expectedReason)
+        {
+            using var files = new TemporaryFiles();
+            var node = new TestObjectNode(new byte[] { 1 });
+            Record(node, fileOffset: 10);
+            if (change == "existing-output")
+            {
+                files.WriteBaseBytes(10, node.GetData(factory: null).Data);
+                File.WriteAllBytes(files.OutputPath, new byte[] { 42 });
+            }
+            node.SetData(new byte[] { 9 });
+
+            Assert.False(IncrementalObjectPatch.TryPatch(
+                files.BasePath,
+                files.OutputPath,
+                new[] { node },
+                factory: null,
+                out string reason,
+                out _));
+            Assert.Equal(expectedReason, reason);
+        }
+
+        [Theory]
+        [InlineData("size")]
+        [InlineData("alignment")]
+        [InlineData("symbols")]
+        [InlineData("relocation-target")]
+        [InlineData("relocation-addend")]
+        public void RejectsChangedFragmentInputs(string change)
+        {
+            using var files = new TemporaryFiles();
+            var oldTarget = new TestObjectNode(new byte[] { 0 });
+            var node = new TestObjectNode(
+                new byte[12],
+                new[] { new Relocation(RelocType.IMAGE_REL_BASED_REL32, 2, oldTarget) });
+            Record(node, fileOffset: 10);
+
+            switch (change)
+            {
+                case "size":
+                    node.SetData(new byte[13]);
+                    break;
+                case "alignment":
+                    node.SetData(new byte[12], alignment: 2);
+                    break;
+                case "symbols":
+                    node.SetData(new byte[12], definedSymbols: new[] { oldTarget });
+                    break;
+                case "relocation-target":
+                    node.SetData(
+                        new byte[12],
+                        relocations: new[]
+                        {
+                            new Relocation(
+                                RelocType.IMAGE_REL_BASED_REL32,
+                                2,
+                                new TestObjectNode(new byte[] { 0 })),
+                        });
+                    break;
+                case "relocation-addend":
+                    byte[] changedData = new byte[12];
+                    changedData[3] = 1;
+                    node.SetData(
+                        changedData,
+                        relocations: new[]
+                        {
+                            new Relocation(RelocType.IMAGE_REL_BASED_REL32, 2, oldTarget),
+                        });
+                    break;
+            }
+
+            Assert.False(IncrementalObjectPatch.TryPatch(
+                files.BasePath,
+                files.OutputPath,
+                new[] { node },
+                factory: null,
+                out string reason,
+                out _));
+            Assert.False(string.IsNullOrEmpty(reason));
+            Assert.False(File.Exists(files.OutputPath));
+        }
+
+        [Theory]
+        [InlineData("missing")]
+        [InlineData("comdat")]
+        [InlineData("bounds")]
+        [InlineData("duplicate-node")]
+        [InlineData("overlap")]
+        public void RejectsInvalidObjectLocations(string change)
+        {
+            using var files = new TemporaryFiles();
+            var node = new TestObjectNode(new byte[] { 1 });
+            var secondNode = new TestObjectNode(new byte[] { 2 });
+
+            IncrementalObjectPatch.Begin(change == "overlap" ? new[] { node, secondNode } : new[] { node });
+            if (change != "missing")
+            {
+                IncrementalObjectPatch.Record(
+                    node,
+                    sectionIndex: 0,
+                    sectionOffset: 0,
+                    node.GetData(factory: null),
+                    isComdat: change == "comdat");
+                if (change == "overlap")
+                {
+                    IncrementalObjectPatch.Record(
+                        secondNode,
+                        sectionIndex: 0,
+                        sectionOffset: 0,
+                        secondNode.GetData(factory: null),
+                        isComdat: false);
+                }
+            }
+            IncrementalObjectPatch.Complete((_, _) => change == "bounds" ? 1000 : 10);
+
+            node.SetData(new byte[] { 9 });
+            secondNode.SetData(new byte[] { 9 });
+            ObjectNode[] changedNodes = change switch
+            {
+                "duplicate-node" => new ObjectNode[] { node, node },
+                "overlap" => new ObjectNode[] { node, secondNode },
+                _ => new ObjectNode[] { node },
+            };
+
+            Assert.False(IncrementalObjectPatch.TryPatch(
+                files.BasePath,
+                files.OutputPath,
+                changedNodes,
+                factory: null,
+                out string reason,
+                out _));
+            Assert.False(string.IsNullOrEmpty(reason));
+            Assert.False(File.Exists(files.OutputPath));
+        }
+
+        private static void Record(TestObjectNode node, long fileOffset)
+        {
+            IncrementalObjectPatch.Begin(new[] { node });
+            IncrementalObjectPatch.Record(
+                node,
+                sectionIndex: 0,
+                sectionOffset: 0,
+                node.GetData(factory: null),
+                isComdat: false);
+            IncrementalObjectPatch.Complete((_, _) => fileOffset);
+        }
+
+        private sealed class TestObjectNode : ObjectNode, ISymbolDefinitionNode
+        {
+            private ObjectData _data;
+
+            public TestObjectNode(byte[] data, Relocation[] relocations = null)
+            {
+                SetData(data, relocations);
+            }
+
+            public int Offset => 0;
+            public override bool IsShareable => false;
+            public override bool StaticDependenciesAreComputed => true;
+            public override int ClassCode => 0x647F3201;
+
+            public void SetData(
+                byte[] data,
+                Relocation[] relocations = null,
+                int alignment = 1,
+                ISymbolDefinitionNode[] definedSymbols = null)
+            {
+                _data = new ObjectData(
+                    data,
+                    relocations ?? Array.Empty<Relocation>(),
+                    alignment,
+                    definedSymbols ?? new ISymbolDefinitionNode[] { this });
+            }
+
+            public override ObjectData GetData(NodeFactory factory, bool relocsOnly = false) => _data;
+            public override ObjectNodeSection GetSection(NodeFactory factory) => ObjectNodeSection.ReadOnlyDataSection;
+            public void AppendMangledName(NameMangler nameMangler, Utf8StringBuilder sb) => sb.Append("test"u8);
+            protected override string GetName(NodeFactory factory) => "test";
+        }
+
+        private sealed class TemporaryFiles : IDisposable
+        {
+            private readonly string _directory =
+                Path.Combine(Path.GetTempPath(), "incremental-object-patch-" + Guid.NewGuid().ToString("N"));
+
+            public TemporaryFiles()
+            {
+                Directory.CreateDirectory(_directory);
+                File.WriteAllBytes(BasePath, new byte[64]);
+            }
+
+            public string BasePath => Path.Combine(_directory, "base.obj");
+            public string OutputPath => Path.Combine(_directory, "output.obj");
+
+            public void WriteBaseBytes(long offset, byte[] data)
+            {
+                using var stream = new FileStream(BasePath, FileMode.Open, FileAccess.Write, FileShare.None);
+                stream.Position = offset;
+                stream.Write(data);
+            }
+
+            public void Dispose()
+            {
+                Directory.Delete(_directory, recursive: true);
+            }
+        }
+    }
+}
