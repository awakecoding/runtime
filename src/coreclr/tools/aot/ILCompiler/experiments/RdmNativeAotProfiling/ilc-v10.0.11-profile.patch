+                }
+
+                public bool Matches(DependencyNodeCore<NodeFactory>.CombinedDependencyListEntry dependency)
+                {
+                    return ReferenceEquals(_node, dependency.Node) &&
+                        ReferenceEquals(_otherReasonNode, dependency.OtherReasonNode) &&
+                        string.Equals(_reason, dependency.Reason, StringComparison.Ordinal);
+                }
+            }
+        }
