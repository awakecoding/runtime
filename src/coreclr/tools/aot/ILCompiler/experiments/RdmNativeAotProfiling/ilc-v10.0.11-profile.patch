index 000000000..158d738e1
--- /dev/null
+++ b/src/coreclr/tools/aot/ILCompiler.DependencyAnalysisFramework/IlcOptimizationExperiments.cs
@@ -0,0 +1,161 @@
+// Licensed to the .NET Foundation under one or more agreements.
+// The .NET Foundation licenses this file to you under the MIT license.
+
+using System;
+using System.Collections.Generic;
+using System.Diagnostics;
+
+namespace ILCompiler.DependencyAnalysisFramework
+{
+    public static class IlcOptimizationExperiments
+    {
+        private static readonly char[] s_experimentSeparators = new char[] { ',', ';', ' ' };
+        private static readonly HashSet<string> s_enabledExperiments = GetEnabledExperiments();
+        private static readonly bool s_metricsEnabled =
+            !string.IsNullOrWhiteSpace(Environment.GetEnvironmentVariable("DOTNET_ILC_PROFILE_PATH"));
+        private static readonly object s_metricsLock = new object();
+        private static readonly Dictionary<string, Timing> s_phaseTimings = new Dictionary<string, Timing>(StringComparer.Ordinal);
+        private static readonly Dictionary<string, long> s_counters = new Dictionary<string, long>(StringComparer.Ordinal);
+
+        public static bool MetricsEnabled => s_metricsEnabled;
+
+        public static bool IsEnabled(string name)
+        {
+            return s_enabledExperiments.Contains(name);
+        }
+
+        public static string[] GetEnabledExperimentNames()
+        {
+            var names = new string[s_enabledExperiments.Count];
+            s_enabledExperiments.CopyTo(names);
+            Array.Sort(names, StringComparer.Ordinal);
+            return names;
+        }
+
+        public static long GetTimestamp()
+        {
+            return s_metricsEnabled ? Stopwatch.GetTimestamp() : 0;
+        }
+
+        public static void RecordPhase(string name, long startTimestamp)
+        {
+            if (!s_metricsEnabled || startTimestamp == 0)
+            {
+                return;
+            }
+
+            long elapsedTicks = Stopwatch.GetTimestamp() - startTimestamp;
+            lock (s_metricsLock)
+            {
+                s_phaseTimings.TryGetValue(name, out Timing timing);
+                timing.Add(elapsedTicks);
+                s_phaseTimings[name] = timing;
+            }
+        }
+
+        public static void SetCounter(string name, long value)
+        {
+            if (!s_metricsEnabled)
+            {
+                return;
+            }
+
+            lock (s_metricsLock)
+            {
+                s_counters[name] = value;
+            }
+        }
+
+        public static PhaseMetric[] GetPhaseMetrics()
+        {
+            lock (s_metricsLock)
+            {
+                var result = new PhaseMetric[s_phaseTimings.Count];
+                int index = 0;
+                foreach (KeyValuePair<string, Timing> pair in s_phaseTimings)
+                {
+                    result[index++] = new PhaseMetric(pair.Key, pair.Value.Count, pair.Value.TotalTicks, pair.Value.MaxTicks);
+                }
+                return result;
+            }
+        }
+
+        public static CounterMetric[] GetCounters()
+        {
+            lock (s_metricsLock)
+            {
+                var result = new CounterMetric[s_counters.Count];
+                int index = 0;
+                foreach (KeyValuePair<string, long> pair in s_counters)
+                {
+                    result[index++] = new CounterMetric(pair.Key, pair.Value);
+                }
+                return result;
+            }
+        }
+
+        private static HashSet<string> GetEnabledExperiments()
+        {
+            var result = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+            string value = Environment.GetEnvironmentVariable("DOTNET_ILC_EXPERIMENTS");
+            if (string.IsNullOrWhiteSpace(value))
+            {
+                return result;
+            }
+
+            foreach (string name in value.Split(s_experimentSeparators, StringSplitOptions.RemoveEmptyEntries))
+            {
+                result.Add(name);
+            }
+
+            return result;
+        }
+
+        private struct Timing
+        {
+            public long Count;
+            public long TotalTicks;
+            public long MaxTicks;
+
+            public void Add(long ticks)
+            {
+                Count++;
+                TotalTicks += ticks;
+                MaxTicks = Math.Max(MaxTicks, ticks);
+            }
+        }
+
+        public readonly struct PhaseMetric
+        {
+            public PhaseMetric(string name, long count, long totalTicks, long maxTicks)
+            {
+                Name = name;
+                Count = count;
+                TotalTicks = totalTicks;
+                MaxTicks = maxTicks;
+            }
+
+            public string Name { get; }
+            public long Count { get; }
+            public long TotalTicks { get; }
+            public long MaxTicks { get; }
+        }
+
+        public readonly struct CounterMetric
+        {
+            public CounterMetric(string name, long value)
+            {
+                Name = name;
+                Value = value;
+            }
+
+            public string Name { get; }
+            public long Value { get; }
+        }
+    }
+
+    public interface IFilteredDependencyNodeComparer<T> : IComparer<T>
+    {
+        bool ShouldSort(T value);
+    }
+}
