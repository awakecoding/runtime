+        private sealed class IncrementalDependencySnapshot
+        {
+            private readonly DependencyEntry[] _staticDependencies;
+            private readonly CombinedDependencyEntry[] _conditionalDependencies;
+
+            private IncrementalDependencySnapshot(
+                DependencyEntry[] staticDependencies,
+                CombinedDependencyEntry[] conditionalDependencies)
+            {
+                _staticDependencies = staticDependencies;
+                _conditionalDependencies = conditionalDependencies;
+            }
+
+            public static IncrementalDependencySnapshot Capture(MethodCodeNode node, NodeFactory factory)
+            {
+                var staticDependencies = new List<DependencyEntry>();
+                foreach (DependencyNodeCore<NodeFactory>.DependencyListEntry dependency in node.GetStaticDependencies(factory))
+                {
+                    staticDependencies.Add(new DependencyEntry(dependency.Node, dependency.Reason));
+                }
+
+                var conditionalDependencies = new List<CombinedDependencyEntry>();
+                foreach (DependencyNodeCore<NodeFactory>.CombinedDependencyListEntry dependency in node.GetConditionalStaticDependencies(factory))
+                {
+                    conditionalDependencies.Add(new CombinedDependencyEntry(
+                        dependency.Node,
+                        dependency.OtherReasonNode,
+                        dependency.Reason));
+                }
+
+                return new IncrementalDependencySnapshot(
+                    staticDependencies.ToArray(),
+                    conditionalDependencies.ToArray());
+            }
+
+            public bool Matches(MethodCodeNode node, NodeFactory factory, out string reason)
+            {
+                int index = 0;
+                foreach (DependencyNodeCore<NodeFactory>.DependencyListEntry dependency in node.GetStaticDependencies(factory))
+                {
+                    if (!dependency.Node.Marked)
+                    {
+                        reason = $"unmarked-static-entry:{index}";
+                        return false;
+                    }
+                    if (index >= _staticDependencies.Length ||
+                        !_staticDependencies[index].Matches(dependency))
+                    {
+                        reason = $"static-entry:{index}";
+                        return false;
+                    }
+                    index++;
+                }
+                if (index != _staticDependencies.Length)
+                {
+                    reason = $"static-count:{_staticDependencies.Length}:{index}";
+                    return false;
+                }
+
+                index = 0;
+                foreach (DependencyNodeCore<NodeFactory>.CombinedDependencyListEntry dependency in node.GetConditionalStaticDependencies(factory))
+                {
+                    if (!dependency.Node.Marked || !dependency.OtherReasonNode.Marked)
+                    {
+                        reason = $"unmarked-conditional-entry:{index}";
+                        return false;
+                    }
+                    if (index >= _conditionalDependencies.Length ||
+                        !_conditionalDependencies[index].Matches(dependency))
+                    {
+                        reason = $"conditional-entry:{index}";
+                        return false;
+                    }
+                    index++;
+                }
+                if (index != _conditionalDependencies.Length)
+                {
+                    reason = $"conditional-count:{_conditionalDependencies.Length}:{index}";
+                    return false;
+                }
+
+                reason = null;
+                return true;
+            }
+
+            private readonly struct DependencyEntry
+            {
+                private readonly DependencyNodeCore<NodeFactory> _node;
+                private readonly string _reason;
+
+                public DependencyEntry(DependencyNodeCore<NodeFactory> node, string reason)
+                {
+                    _node = node;
+                    _reason = reason;
+                }
+
+                public bool Matches(DependencyNodeCore<NodeFactory>.DependencyListEntry dependency)
+                {
+                    return ReferenceEquals(_node, dependency.Node) &&
+                        string.Equals(_reason, dependency.Reason, StringComparison.Ordinal);
+                }
+            }
+
+            private readonly struct CombinedDependencyEntry
+            {
+                private readonly DependencyNodeCore<NodeFactory> _node;
+                private readonly DependencyNodeCore<NodeFactory> _otherReasonNode;
+                private readonly string _reason;
+
+                public CombinedDependencyEntry(
+                    DependencyNodeCore<NodeFactory> node,
+                    DependencyNodeCore<NodeFactory> otherReasonNode,
+                    string reason)
+                {
+                    _node = node;
+                    _otherReasonNode = otherReasonNode;
