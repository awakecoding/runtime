+
+        private void RunIncrementalBodyUpdate(
+            string incrementalOutputPath,
+            string baseAssemblyPath,
+            string updatedAssemblyPath,
+            string baseObjectPath,
+            IReadOnlyCollection<DependencyNodeCore<NodeFactory>> nodes,
+            ObjectWritingOptions options,
+            string metricSuffix)
+        {
+            if (_incrementalBodyUpdateUnsupportedReason is not null)
+            {
+                ThrowIncrementalFallback(
+                    $"unsupported-incremental-configuration:{_incrementalBodyUpdateUnsupportedReason}");
+            }
+
