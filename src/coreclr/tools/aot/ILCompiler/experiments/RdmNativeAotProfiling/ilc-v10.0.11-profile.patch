+        private sealed class ChunkedValueList<T>
+        {
+            private const int ChunkShift = 16;
+            private const int ChunkSize = 1 << ChunkShift;
+            private const int ChunkMask = ChunkSize - 1;
+
+            private readonly List<T[]> _chunks = new();
+
+            public int Count { get; private set; }
+            public int ChunkCount => _chunks.Count;
+
+            public void Add(T value)
+            {
+                int index = Count;
+                if ((index & ChunkMask) == 0)
+                {
+                    _chunks.Add(new T[ChunkSize]);
+                }
+                _chunks[index >> ChunkShift][index & ChunkMask] = value;
+                Count = index + 1;
+            }
+
+            public void Clear()
+            {
+                _chunks.Clear();
+                Count = 0;
+            }
+
+            public Enumerator GetEnumerator()
+            {
+                return new Enumerator(this);
+            }
+
+            public struct Enumerator
+            {
+                private readonly ChunkedValueList<T> _list;
+                private int _index;
+                private T[] _chunk;
+
+                public Enumerator(ChunkedValueList<T> list)
+                {
+                    _list = list;
+                    _index = -1;
+                    _chunk = null;
+                }
+
+                public readonly ref T Current => ref _chunk[_index & ChunkMask];
+
+                public bool MoveNext()
+                {
+                    int index = ++_index;
+                    if (index >= _list.Count)
+                    {
+                        return false;
+                    }
+                    if ((index & ChunkMask) == 0)
+                    {
+                        _chunk = _list._chunks[index >> ChunkShift];
+                    }
+
+                    return true;
+                }
+            }
+        }
