+// Licensed to the .NET Foundation under one or more agreements.
+// The .NET Foundation licenses this file to you under the MIT license.
+
+using System;
+using System.Collections.Generic;
+using System.IO;
+
+using ILCompiler.DependencyAnalysis;
+
+namespace ILCompiler.ObjectWriter
+{
+    public static class IncrementalObjectPatch
+    {
+        private static Dictionary<ObjectNode, Entry> s_entries;
+        private static bool s_recording;
+
+        public static void Begin(IEnumerable<ObjectNode> nodes)
+        {
+            var entries = new Dictionary<ObjectNode, Entry>();
+            foreach (ObjectNode node in nodes)
+            {
+                entries.Add(node, new Entry());
+            }
+
+            s_entries = entries;
+            s_recording = true;
+        }
+
+        public static void Record(
+            ObjectNode node,
+            int sectionIndex,
+            long sectionOffset,
+            ObjectNode.ObjectData data,
+            bool isComdat)
+        {
+            if (!s_recording ||
+                s_entries is null ||
+                !s_entries.TryGetValue(node, out Entry entry))
+            {
+                return;
+            }
+
+            entry.SectionIndex = sectionIndex;
+            entry.SectionOffset = sectionOffset;
+            entry.Data = (byte[])data.Data.Clone();
+            entry.Relocations = data.Relocs;
+            entry.DefinedSymbols = data.DefinedSymbols;
+            entry.Alignment = data.Alignment;
+            entry.IsComdat = isComdat;
+            entry.Recorded = true;
+        }
+
+        public static void Complete(Func<int, long, long> getFileOffset)
+        {
+            if (!s_recording || s_entries is null)
+            {
+                return;
+            }
+
+            foreach (Entry entry in s_entries.Values)
+            {
+                if (entry.Recorded)
+                {
+                    entry.FileOffset = getFileOffset(entry.SectionIndex, entry.SectionOffset);
+                }
+            }
+
+            s_recording = false;
+        }
+
+        public static bool TryPatch(
+            string baseObjectPath,
+            string outputObjectPath,
+            IEnumerable<ObjectNode> changedNodes,
+            NodeFactory factory,
+            out string reason,
+            out long patchedByteCount)
+        {
+            patchedByteCount = 0;
+            if (s_entries is null)
+            {
+                reason = "object-locations-were-not-recorded";
+                return false;
+            }
+
+            var patches = new List<Patch>();
+            var seenNodes = new HashSet<ObjectNode>();
+            if (!TryGetObjectLength(baseObjectPath, out long baseObjectLength, out reason))
+            {
+                return false;
+            }
+            foreach (ObjectNode node in changedNodes)
+            {
+                if (!seenNodes.Add(node))
+                {
+                    reason = "changed-node-was-specified-more-than-once";
+                    return false;
+                }
+                if (!s_entries.TryGetValue(node, out Entry entry) ||
+                    !entry.Recorded ||
+                    entry.FileOffset < 0)
+                {
+                    reason = "changed-node-location-not-recorded";
+                    return false;
+                }
+                if (entry.IsComdat)
+                {
+                    reason = "changed-node-is-comdat";
+                    return false;
+                }
+
+                ObjectNode.ObjectData updatedData = node.GetData(factory);
+                if (entry.FileOffset > baseObjectLength ||
+                    updatedData.Data.Length > baseObjectLength - entry.FileOffset)
+                {
+                    reason = "changed-node-location-out-of-bounds";
+                    return false;
+                }
+                if (updatedData.Data.Length != entry.Data.Length)
+                {
+                    reason = "changed-node-size-changed";
+                    return false;
+                }
+                if (updatedData.Alignment != entry.Alignment)
+                {
+                    reason = "changed-node-alignment-changed";
+                    return false;
+                }
+                if (!DefinedSymbolsMatch(entry.DefinedSymbols, updatedData.DefinedSymbols))
+                {
+                    reason = "changed-node-defined-symbols-changed";
+                    return false;
+                }
+                if (!RelocationsMatch(entry.Relocations, updatedData.Relocs))
+                {
+                    reason = "changed-node-relocations-changed";
+                    return false;
+                }
+
+                bool[] relocationBytes = GetRelocationBytes(updatedData.Data.Length, updatedData.Relocs);
+                for (int i = 0; i < updatedData.Data.Length; i++)
+                {
+                    if (entry.Data[i] == updatedData.Data[i])
+                    {
+                        continue;
+                    }
+                    if (relocationBytes[i])
+                    {
+                        reason = "changed-node-relocation-addend-changed";
+                        return false;
+                    }
+
+                    patches.Add(new Patch(entry.FileOffset + i, entry.Data[i], updatedData.Data[i]));
+                }
+            }
+
+            patches.Sort(static (left, right) => left.Offset.CompareTo(right.Offset));
+            for (int i = 1; i < patches.Count; i++)
+            {
+                if (patches[i - 1].Offset == patches[i].Offset)
+                {
+                    reason = "patch-offset-overlap";
+                    return false;
+                }
+            }
+
+            if (!TryWritePatchedObject(
+                baseObjectPath,
+                outputObjectPath,
+                baseObjectLength,
+                patches,
+                out reason))
+            {
+                return false;
+            }
+
+            patchedByteCount = patches.Count;
+            reason = null;
+            return true;
+        }
+
+        private static bool TryWritePatchedObject(
+            string baseObjectPath,
+            string outputObjectPath,
+            long baseObjectLength,
+            List<Patch> patches,
+            out string reason)
+        {
+            if (File.Exists(outputObjectPath))
+            {
+                reason = "patched-object-output-already-exists";
+                return false;
+            }
+
+            string temporaryPath = outputObjectPath + "." + Guid.NewGuid().ToString("N") + ".tmp";
+            try
+            {
+                using (var baseStream = new FileStream(
+                    baseObjectPath,
+                    FileMode.Open,
+                    FileAccess.Read,
+                    FileShare.Read))
+                {
+                    foreach (Patch patch in patches)
+                    {
+                        baseStream.Position = patch.Offset;
+                        if (baseStream.ReadByte() != patch.ExpectedValue)
+                        {
+                            reason = "base-object-byte-does-not-match-recorded-fragment";
+                            return false;
+                        }
+                    }
+                }
+
+                File.Copy(baseObjectPath, temporaryPath, overwrite: false);
+                using (var stream = new FileStream(
+                    temporaryPath,
+                    FileMode.Open,
+                    FileAccess.Write,
+                    FileShare.None))
+                {
+                    foreach (Patch patch in patches)
+                    {
+                        stream.Position = patch.Offset;
+                        stream.WriteByte(patch.Value);
+                    }
+                    stream.Flush(flushToDisk: true);
+                }
+
+                if (new FileInfo(temporaryPath).Length != baseObjectLength)
+                {
+                    reason = AppendCleanupFailure(
+                        "patched-object-length-changed",
+                        TryDeleteTemporaryFile(temporaryPath));
+                    return false;
+                }
+
+                File.Move(temporaryPath, outputObjectPath);
+            }
+            catch (IOException ex)
+            {
+                reason = AppendCleanupFailure(
+                    $"object-patch-io-failure:{ex.HResult:X8}",
+                    TryDeleteTemporaryFile(temporaryPath));
+                return false;
+            }
+            catch (UnauthorizedAccessException ex)
+            {
+                reason = AppendCleanupFailure(
+                    $"object-patch-access-failure:{ex.HResult:X8}",
+                    TryDeleteTemporaryFile(temporaryPath));
+                return false;
+            }
+
+            reason = null;
+            return true;
+        }
+
+        private static bool TryGetObjectLength(string path, out long length, out string reason)
+        {
+            try
+            {
+                length = new FileInfo(path).Length;
+                reason = null;
+                return true;
+            }
+            catch (IOException ex)
+            {
+                length = 0;
+                reason = $"base-object-io-failure:{ex.HResult:X8}";
+                return false;
+            }
+            catch (UnauthorizedAccessException ex)
+            {
+                length = 0;
+                reason = $"base-object-access-failure:{ex.HResult:X8}";
+                return false;
+            }
+        }
+
+        private static string TryDeleteTemporaryFile(string path)
+        {
+            try
+            {
+                File.Delete(path);
+                return null;
+            }
+            catch (IOException ex)
+            {
+                return $"temporary-object-cleanup-io-failure:{ex.HResult:X8}";
+            }
+            catch (UnauthorizedAccessException ex)
+            {
+                return $"temporary-object-cleanup-access-failure:{ex.HResult:X8}";
+            }
+        }
+
+        private static string AppendCleanupFailure(string reason, string cleanupFailure)
+        {
+            return cleanupFailure is null ? reason : $"{reason};{cleanupFailure}";
+        }
+
+        private static bool DefinedSymbolsMatch(
+            ISymbolDefinitionNode[] left,
+            ISymbolDefinitionNode[] right)
+        {
+            int leftLength = left?.Length ?? 0;
+            int rightLength = right?.Length ?? 0;
+            if (leftLength != rightLength)
+            {
+                return false;
+            }
+
+            for (int i = 0; i < leftLength; i++)
+            {
+                if (!ReferenceEquals(left[i], right[i]) ||
+                    left[i].Offset != right[i].Offset)
+                {
+                    return false;
+                }
+            }
+
+            return true;
+        }
+
+        private static bool RelocationsMatch(Relocation[] left, Relocation[] right)
+        {
+            int leftLength = left?.Length ?? 0;
+            int rightLength = right?.Length ?? 0;
+            if (leftLength != rightLength)
+            {
+                return false;
+            }
+
+            for (int i = 0; i < leftLength; i++)
+            {
+                if (left[i].RelocType != right[i].RelocType ||
+                    left[i].Offset != right[i].Offset ||
+                    !ReferenceEquals(left[i].Target, right[i].Target))
+                {
+                    return false;
+                }
+            }
+
+            return true;
+        }
+
+        private static bool[] GetRelocationBytes(int dataLength, Relocation[] relocations)
+        {
+            var result = new bool[dataLength];
+            if (relocations is null)
+            {
+                return result;
+            }
+
+            foreach (Relocation relocation in relocations)
+            {
+                // Eight bytes is conservative for all relocations used by the 64-bit prototype.
+                int end = Math.Min(dataLength, relocation.Offset + sizeof(long));
+                for (int i = relocation.Offset; i < end; i++)
+                {
+                    result[i] = true;
+                }
+            }
+
+            return result;
+        }
+
+        private sealed class Entry
+        {
+            public int SectionIndex;
+            public long SectionOffset;
+            public long FileOffset = -1;
+            public byte[] Data;
+            public Relocation[] Relocations;
+            public ISymbolDefinitionNode[] DefinedSymbols;
+            public int Alignment;
+            public bool IsComdat;
+            public bool Recorded;
+        }
+
+        private readonly struct Patch
+        {
+            public Patch(long offset, byte expectedValue, byte value)
+            {
+                Offset = offset;
+                ExpectedValue = expectedValue;
+                Value = value;
+            }
+
+            public long Offset { get; }
+            public byte ExpectedValue { get; }
+            public byte Value { get; }
+        }
+    }
+}
