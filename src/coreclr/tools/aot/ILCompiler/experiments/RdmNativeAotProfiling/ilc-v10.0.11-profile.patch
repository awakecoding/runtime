+            var dependencySnapshots = new List<IncrementalDependencySnapshot>();
+            var codeStateSnapshots = new List<IncrementalCodeStateSnapshot>();
+            int affectedMethodCount = update.GetAffectedMethodCount(_currentIncrementalUpdate);
