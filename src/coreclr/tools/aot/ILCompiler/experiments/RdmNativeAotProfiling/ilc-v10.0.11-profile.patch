+                "incremental-private-memory-bytes-after" + metricSuffix,
+                currentProcess.PrivateMemorySize64);
+            CompilerProfile.SetCounter(
+                "incremental-working-set-bytes-after" + metricSuffix,
+                currentProcess.WorkingSet64);
+            CompilerProfile.RecordPhase("incremental-update-total" + metricSuffix, incrementalUpdateStart);
+            _currentIncrementalUpdate = update;
+            WriteIncrementalStatus("success", null, update.ChangedMethodCount, dirtyMethods.Count);
+        }
+
+        private void PrepareIncrementalObjectPatch(
+            IReadOnlyCollection<DependencyNodeCore<NodeFactory>> nodes)
+        {
+            if (!string.Equals(
+                Environment.GetEnvironmentVariable("DOTNET_ILC_INCREMENTAL_FAST_OBJECT_PATCH"),
+                "1",
+                StringComparison.Ordinal) ||
+                _incrementalBodyUpdateUnsupportedReason is not null)
+            {
+                return;
+            }
+
+            if (!IncrementalBodyUpdate.TryCreate(
+                _incrementalBaseILProvider,
+                Environment.GetEnvironmentVariable("DOTNET_ILC_INCREMENTAL_BASE_ASSEMBLY"),
+                Environment.GetEnvironmentVariable("DOTNET_ILC_INCREMENTAL_UPDATED_ASSEMBLY"),
+                allowUnchangedTarget: false,
+                out IncrementalBodyUpdate update,
+                out _))
+            {
+                return;
+            }
+
+            var changedNodes = new List<ObjectNode>();
+            var dirtyMethods = new List<MethodCodeNode>();
+            int objectNodeCount = 0;
+            foreach (DependencyNodeCore<NodeFactory> node in nodes)
+            {
+                if (node is not ObjectNode objectNode)
+                {
+                    continue;
+                }
+
+                objectNodeCount++;
+                if (objectNode is MethodCodeNode methodCodeNode &&
+                    update.IsChangedMethod(methodCodeNode.Method))
+                {
+                    changedNodes.Add(methodCodeNode);
+                    dirtyMethods.Add(methodCodeNode);
+                }
+            }
